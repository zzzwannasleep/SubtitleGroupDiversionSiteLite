# Docker 自部署配置：复制为 .env 后修改（docker compose 自动读取）

# 站点对外地址：RSS 链接就是它 + /rss.xml，种子下载是它 + /t/<id>.torrent。
# 默认指向站点自身；有反向代理/独立域名时改成对外地址即可。
PUBLIC_URL=http://localhost:8787

# 必填：管理员密码，admin 账号用它登录
ADMIN_PASSWORD=change-me

# 可选：登录 cookie 的签名密钥；不填则首次启动自动生成并保存在数据卷里
SECRET_KEY=

# 可选：站点名，默认“RSS种子站点”
SITE_NAME=

# 宿主机映射端口（修改后 PUBLIC_URL 也要同步改）
SGDS_PORT=8787
