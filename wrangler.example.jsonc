// Copy to wrangler.jsonc and fill in (wrangler.jsonc is gitignored).
// Keep this file ASCII-only: pywrangler reads it with the system codec (GBK on Chinese Windows).
{
  "name": "subtitle-group-diversion-site",
  "main": "src/entry.py",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["python_workers"],
  "observability": { "enabled": true },
  "vars": {
    // Custom domain bound to the R2 bucket. rss.xml and .torrent files are served from here via CDN.
    "PUBLIC_URL": "https://files.example.com"
    // "SITE_NAME": "My Site"   (non-ASCII names need PYTHONUTF8=1 on Windows)
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "sgds", "database_id": "<id from: npx wrangler d1 create sgds>" }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "sgds" }
  ]
}
