[Unit]
Description=RSS Torrent Site
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/rss-torrent-site
Environment="PATH=/var/www/rss-torrent-site/venv/bin"
EnvironmentFile=/var/www/rss-torrent-site/.env
ExecStart=/var/www/rss-torrent-site/venv/bin/gunicorn -w 4 -b 127.0.0.1:8000 --access-logfile /var/log/rss-torrent/access.log --error-logfile /var/log/rss-torrent/error.log app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
