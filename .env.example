# 生产环境配置
# 复制此文件为 .env 并修改配置

# Flask密钥（必须修改！）
SECRET_KEY=your-super-secret-key-change-this-now

# 管理员密码（首次运行时设置）
ADMIN_PASSWORD=your-secure-admin-password

# 站点名称
SITE_NAME=RSS种子站点

# 上传文件夹路径
UPLOAD_FOLDER=uploads

# 数据库路径
DATABASE_PATH=data/site.db

# 最大文件大小（MB）
MAX_FILE_SIZE=16

# ==========================================
# 反向代理配置（使用 Nginx/OpenResty 时必须配置）
# ==========================================

# 强制 URL Scheme（https/http）
# 如果通过反向代理使用 HTTPS，设置为 https
# PREFERRED_URL_SCHEME=https

# ProxyFix 配置 - 处理 X-Forwarded-* 头
# 这些值通常保持默认即可，根据你的反向代理层级调整
# PROXY_FIX_X_FOR=1
# PROXY_FIX_X_PROTO=1
# PROXY_FIX_X_HOST=1
# PROXY_FIX_X_PORT=0
# PROXY_FIX_X_PREFIX=0
